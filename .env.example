# Copier ce fichier en .env et adapter les valeurs.
# Le fichier .env n'est jamais commité.

# Adresse de l'API FastAPI appelée par l'application Streamlit
# (en local : http://127.0.0.1:8000 ; en ligne : https://<nom-du-service>.onrender.com)
API_URL=http://127.0.0.1:8000

# Délai maximal d'attente d'une réponse de l'API, en secondes
# (30 conseillé pour une API hébergée gratuitement, qui peut être en veille)
API_TIMEOUT=10
